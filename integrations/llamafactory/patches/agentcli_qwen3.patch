diff --git a/src/llamafactory/data/processor/supervised.py b/src/llamafactory/data/processor/supervised.py
index b5aba11b..35adbbe0 100644
--- a/src/llamafactory/data/processor/supervised.py
+++ b/src/llamafactory/data/processor/supervised.py
@@ -32,0 +33,30 @@ class SupervisedDatasetProcessor(DatasetProcessor):
+    def _encode_agentcli_example(
+        self,
+        messages: list[dict[str, Any]],
+        tools: list[dict[str, Any]],
+    ) -> tuple[list[int], list[int]]:
+        if self.data_args.train_on_prompt or not self.data_args.mask_history:
+            raise ValueError("AgentCli SFT requires train_on_prompt=false and mask_history=true.")
+        if not messages or messages[-1].get("role") != "assistant":
+            raise ValueError("AgentCli SFT target must be the final assistant message.")
+
+        prompt_ids = self.tokenizer.apply_chat_template(
+            messages[:-1],
+            tools=tools,
+            add_generation_prompt=True,
+            tokenize=True,
+        )
+        input_ids = self.tokenizer.apply_chat_template(
+            messages,
+            tools=tools,
+            add_generation_prompt=False,
+            tokenize=True,
+        )
+        if input_ids[: len(prompt_ids)] != prompt_ids or len(input_ids) == len(prompt_ids):
+            raise ValueError("AgentCli prompt tokens must be a strict prefix of the full sequence.")
+        if len(input_ids) > self.data_args.cutoff_len:
+            raise ValueError("AgentCli SFT samples must not be truncated.")
+
+        labels = [IGNORE_INDEX] * len(prompt_ids) + input_ids[len(prompt_ids) :]
+        return input_ids, labels
+
