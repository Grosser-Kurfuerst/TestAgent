diff --git a/src/llamafactory/data/converter.py b/src/llamafactory/data/converter.py
index 7ec6f12b..bcb29cbb 100644
--- a/src/llamafactory/data/converter.py
+++ b/src/llamafactory/data/converter.py
@@ -369,0 +370,23 @@ class OpenAIDatasetConverter(DatasetConverter):
+@dataclass
+class AgentCliOpenAIToolsDatasetConverter(OpenAIDatasetConverter):
+    def __call__(self, example: dict[str, Any]) -> dict[str, Any]:
+        output = super().__call__(example)
+        messages = example[self.dataset_attr.messages]
+        tools = example[self.dataset_attr.tools]
+        if not isinstance(messages, list) or not isinstance(tools, list):
+            raise ValueError("AgentCli messages and tools must be JSON arrays.")
+
+        for message in messages:
+            if not isinstance(message, dict):
+                raise ValueError("AgentCli messages must be JSON objects.")
+            for tool_call in message.get("tool_calls", []):
+                function = tool_call.get("function") if isinstance(tool_call, dict) else None
+                arguments = function.get("arguments") if isinstance(function, dict) else None
+                if not isinstance(arguments, dict):
+                    raise ValueError("AgentCli function.arguments must be a JSON object.")
+
+        output["_agentcli_messages"] = messages
+        output["_agentcli_tools"] = tools
+        return output
+
+
@@ -373,0 +397 @@ DATASET_CONVERTERS = {
+    "agentcli_openai_tools": AgentCliOpenAIToolsDatasetConverter,
