# Public example config. Copy to .env and fill in your own OpenAI-compatible API settings.
MY_AGENT_LLM_PROVIDER=openai
MY_AGENT_API_KEY=sk-your-api-key
MY_AGENT_BASE_URL=https://api.openai.com/v1
MY_AGENT_MODEL=gpt-4o-mini
MY_AGENT_TEMPERATURE=0.1

# Agent runtime limits
MY_AGENT_MAX_STEPS=8
MY_AGENT_COMMAND_TIMEOUT=60
MY_AGENT_TRACE_DIR=traces

# Dynamic tools
# Project config tools are loaded from <repo>/.agentcli/tools.json only when explicitly enabled.
AGENTCLI_ENABLE_PROJECT_TOOLS=0
AGENTCLI_ENABLE_PROJECT_PLUGINS=0
# Optional os.pathsep-separated user config files. Defaults to ~/.config/agentcli/tools.json.
# AGENTCLI_TOOL_CONFIGS=~/.config/agentcli/tools.json
