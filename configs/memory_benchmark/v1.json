{
  "schema_version": "memory-benchmark-config-v1",
  "source_lock_path": "configs/memory_benchmark/source-lock.json",
  "environment": {
    "lifelong_agent_bench_root": "AGENTCLI_LIFELONG_AGENT_BENCH_ROOT",
    "intercode_root": "AGENTCLI_INTERCODE_ROOT",
    "data_root": "AGENTCLI_MEMORY_BENCHMARK_DATA_ROOT",
    "mem0_config": "AGENTCLI_MEM0_CONFIG_PATH"
  },
  "benchmarks": {
    "lifelong_os": {
      "source": "lifelong_agent_bench",
      "subset": "os",
      "source_split": "train",
      "evaluation_split": "test",
      "limit": 40,
      "order_policy": "source_order"
    },
    "intercode_bash": {
      "source": "intercode",
      "subset": "bash",
      "source_split": "official_file",
      "evaluation_split": "test",
      "limit": 40,
      "order_policy": "source_order"
    }
  },
  "arms": {
    "no_memory": {
      "enabled": true,
      "memory_enabled": true,
      "memory_evolver_mode": "off",
      "persistent_writes": false
    },
    "agentcli_four_tier": {
      "enabled": true,
      "memory_enabled": true,
      "memory_evolver_mode": "formal",
      "persistent_writes": true
    },
    "mem0": {
      "enabled": true,
      "memory_enabled": true,
      "memory_evolver_mode": "off",
      "persistent_writes": true,
      "service_mode": "local"
    }
  },
  "runtime": {
    "context_window": 32768,
    "response_reserve_tokens": 4096,
    "compression_buffer_tokens": 2048,
    "repo_context_budget_tokens": 6000,
    "tool_schema_budget_tokens": 8000,
    "memory_short_term_tokens": 16000,
    "memory_context_tokens": 1800,
    "memory_tool_result_chars": 4000,
    "agent_mode": "react",
    "max_steps": 40,
    "command_timeout_seconds": 120,
    "actor_temperature": 1.0
  },
  "embedding": {
    "model": "Qwen/Qwen3-Embedding-0.6B",
    "revision_env": "AGENTCLI_BENCHMARK_EMBEDDING_REVISION"
  },
  "memory": {
    "generation_temperature": 1.0,
    "generation_top_p": 0.95,
    "selected_max_items": 20,
    "selected_content_max_tokens": 1800,
    "agentcli_candidate_top_k_per_tier": 50,
    "agentcli_maintenance_interval_tasks": 30,
    "agentcli_retrieval_backend": "embedding_cosine",
    "agentcli_selection_backend": "llm",
    "agentcli_maintenance_enabled": true,
    "mem0_search_limit": 50
  },
  "output_root": "evaluationResults/memory_benchmark",
  "seeds": [42, 43, 44],
  "actor_sampling_seed_supported": false,
  "smoke": {
    "task_count": 8,
    "maintenance_interval_tasks": 4
  }
}
